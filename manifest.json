{
    "manifest_version": 3,
    "name": "MoneyTree Tool",
    "description": "最小限の Chrome 拡張機能テンプレートです。",
    "version": "1.0.0",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://app.getmoneytree.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": ["scripting", "activeTab", "clipboardWrite"]
}